PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/cashflow_copilot
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# Optional: both values enable AI-selected, source-backed explanations. Leave blank for deterministic fallback.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: model-based Cash Copilot intent selection; financial facts stay local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Local Cash Copilot. Takes priority over Gemini; no cloud API key required.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=alibilge/Huihui-GLM-4.6V-Flash-abliterated:q4_k_s
# Optional CPU mode if the local CUDA runtime fails: OLLAMA_NUM_GPU=0
OLLAMA_NUM_CTX=4096
# Optional Windows CUDA 12 runner for GPUs affected by CUDA 13 warm-up crashes.
# OLLAMA_BASE_URL=http://127.0.0.1:11435
# OLLAMA_EXECUTABLE=D:/AI/Ollama/App/ollama.exe
# OLLAMA_MODELS=D:/AI/Ollama/Models
# OLLAMA_LLM_LIBRARY=cuda_v12
# OLLAMA_NUM_GPU=26
# Optional new-feature gates. Keep these secrets server-side; use synthetic data until tenant auth is added.
FEATURE_ADMIN_TOKEN=
TALLY_SYNC_TOKEN=
TALLY_SYNC_WORKSPACE_ID=
TELEMETRY_HMAC_KEY=
OBSERVATION_TOKEN=
# Set to 1 only with a localhost MongoDB to use browser bridge testing without an owner token.
LOCAL_SYNTHETIC_DEV=0
# Razorpay test mode only. Keep these on the server; configure payment_link.paid webhook separately.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Automatic WhatsApp sending is off by default. Local demo follow-ups need neither setting.
FOLLOWUP_ALLOW_SEND=0
# Shared with n8n as an Authorization: Bearer header. Never put this in client code.
FOLLOWUP_AUTOMATION_TOKEN=

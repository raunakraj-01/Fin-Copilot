PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/cashflow_copilot
CLIENT_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
NODE_ENV=development
# Optional: both values enable AI-selected, source-backed explanations. Leave blank for deterministic fallback.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: model-based Cash Copilot intent selection; financial facts stay local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Business access uses signed-in database-backed sessions. Set the exact browser origin.
# Production requires HTTPS; NODE_ENV=production enables Secure, host-only cookies.
# Shared FEATURE_ADMIN_TOKEN, TALLY_SYNC_TOKEN and OBSERVATION_TOKEN are no longer accepted.
TELEMETRY_HMAC_KEY=
# This controls local synthetic labels only; it never bypasses login or business membership.
LOCAL_SYNTHETIC_DEV=0
# Razorpay test mode only. Keep these on the server; configure payment_link.paid webhook separately.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Automatic WhatsApp sending is off by default. Local demo follow-ups need neither setting.
FOLLOWUP_ALLOW_SEND=0
# Morning Cash Brief automation. Set MORNING_BRIEF_ALLOW_SEND=1 to enable scheduled dispatch.
# MORNING_BRIEF_SCHEDULE is the IST time (HH:MM) to fire daily. Default: 07:00
# MORNING_BRIEF_WORKSPACE_ID optionally restricts briefing to a single workspace ID.
# MORNING_BRIEF_WEBHOOK_URL receives a POST with the full brief JSON (whatsappText, whatsappUrl, metrics etc.)
MORNING_BRIEF_ALLOW_SEND=0
MORNING_BRIEF_SCHEDULE=07:00
MORNING_BRIEF_WORKSPACE_ID=
MORNING_BRIEF_WEBHOOK_URL=
# 2-Way Telegram Fin-RAG Assistant (multi-tenant self-serve linking via webhook or local polling)
TELEGRAM_BOT_TOKEN=
# Optional bot username without @ (auto-discovered via Telegram getMe if unset)
TELEGRAM_BOT_USERNAME=
# Optional webhook secret token (auto-derived from TELEGRAM_BOT_TOKEN via HMAC if unset)
TELEGRAM_WEBHOOK_SECRET=
# Optional explicit HTTPS webhook URL (defaults to <CLIENT_ORIGIN or RENDER_EXTERNAL_URL>/api/webhooks/telegram)
TELEGRAM_WEBHOOK_URL=
# Optional local-dev only: allow multi-tenant /link polling without HTTPS webhook URL
TELEGRAM_MULTI_TENANT_POLLING=0
# Legacy single-tenant env allowlist fallback (leave blank for multi-tenant SaaS)
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_WORKSPACE_ID=
# Create a per-business automation credential in Setup & Import → Business access.
# n8n uses that credential in its Authorization header; shared automation tokens are rejected.
# Configurable Rate Limiting (Auth strict w/ exponential backoff, Public moderate, Authenticated looser)
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_IP_MAX=60
RATE_LIMIT_AUTH_REGISTER_IP_MAX=10
RATE_LIMIT_AUTH_ACCOUNT_MAX=12
RATE_LIMIT_AUTH_REGISTER_ACCOUNT_MAX=5
RATE_LIMIT_AUTH_RECOVER_ACCOUNT_MAX=5
RATE_LIMIT_AUTH_BACKOFF_BASE_MS=5000
RATE_LIMIT_AUTH_BACKOFF_MAX_MS=900000
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=60
RATE_LIMIT_WEBHOOK_WINDOW_MS=60000
RATE_LIMIT_WEBHOOK_MAX=60
RATE_LIMIT_AUTHED_WINDOW_MS=60000
RATE_LIMIT_AUTHED_MAX=300
RATE_LIMIT_AUTHED_IP_MAX=1000

# ==============================================================================
# Fin-Copilot (Kavach MSME Risk Radar) - Production Environment Variables
# Copy to .env.production or export in your cloud orchestrator (AWS ECS / GCP / Kube)
# ==============================================================================

# Application Runtime
NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# Database Connection (MongoDB Atlas or Replica Set)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/fin_copilot

# Cryptographic Session & CSRF Key
# Generate using: openssl rand -base64 32
SESSION_SECRET=CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS

# Allowed CORS Origins (Comma-separated exact origins)
ALLOWED_ORIGINS=https://app.fincopilot.in,https://fincopilot.in

# Google Gemini API (For AI Financial RAG Copilot)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Razorpay Payment Gateway & Early Settlement Webhooks
# Obtain from Razorpay Dashboard -> Settings -> API Keys & Webhooks
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret

# Statutory Section 43B(h) Audit Parameters
STATUTORY_INTEREST_RATE_BASIS_POINTS=300 # 3x RBI Bank Rate per MSMED Act
DEFAULT_CREDIT_PERIOD_DAYS=45
MINIMUM_ADVANCE_REQUIRED_RATIO=0.30
